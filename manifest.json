{
  "manifest_version": 3,
  "name": "Dialogue Export",
  "version": "0.5.9",
  "description": "Export ChatGPT and Gemini conversations to TXT, Markdown, HTML, JSON, or PDF.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://images.openai.com/*"
  ],
  "action": {
    "default_title": "Dialogue Export",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html",
    "theme_icons": [
      {"light":"icons/icon-light-16.png","dark":"icons/icon-16.png","size":16},
      {"light":"icons/icon-light-32.png","dark":"icons/icon-32.png","size":32}
    ]
  },
  "background": {
    "scripts": [
      "shared/timestamps.js",
      "content/api-media.js",
      "shared/renderers.js",
      "shared/parts-store.js",
      "shared/zip.js",
      "archive/background.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/timestamps.js",
        "content/timestamps.js",
        "content/media.js",
        "content/extract.js",
        "shared/vendor/markdown-it.js",
        "content/components.js",
        "content/markdown.js",
        "content/api-media.js",
        "content/chatgpt-api.js",
        "content/history.js",
        "content/panel.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["popup/popup.html", "icons/dialogue.svg", "icons/archive.svg"],
    "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "dialogue-export@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
