{
  "manifest_version": 3,
  "name": "Dialogue Export",
  "version": "0.2.0",
  "description": "Export open conversations from chatgpt.com to TXT, Markdown, HTML, JSON, or PDF.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_title": "Dialogue Export",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["shared/renderers.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dialogue-export@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
